<idea-plugin>
    <id>ski.chrzanow.foldableprojectview</id>
    <name>Foldable Project View</name>
    <vendor>hsz</vendor>

    <description><![CDATA[
        <b>Support Foldable Project View</b><br>
        If you find this plugin useful, support its development via
        <a href="https://github.com/sponsors/hsz">GitHub Sponsors</a>,
        <a href="https://ko-fi.com/hszanowski">Ko-fi</a>, or
        <a href="https://paypal.me/hsz">PayPal</a>.
        You can also find my other projects on <a href="https://github.com/hsz">GitHub</a>.<br><br>
        The Foldable Project View is a plugin for the IntelliJ-based IDEs that lets you fold files located in the root of your project.<br><br>
        Available features:
        <ul>
          <li>Fold matching root elements of the project modules in the Project View</li>
          <li>Multiple named folding rules with custom foreground/background colors</li>
          <li>Enable/disable folding via Preferences or Project View options menu</li>
          <li>Optionally fold directories</li>
          <li>Optionally fold in nested directories</li>
          <li>Fold VCS-ignored files</li>
          <li>Hide empty groups</li>
          <li>Hide matched elements instead of grouping them, per rule</li>
          <li>Case-insensitive matching</li>
          <li>Search scopes based on the folding rules</li>
          <li>Live Project View preview</li>
        </ul>
        <img src="https://github.com/hsz/intellij-foldable-projectview/raw/main/.github/readme/foldable-projectview.gif" alt="Foldable Project View Demo" />
        ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.FoldableProjectView</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <projectConfigurable
                groupId="tools"
                key="foldableProjectView.name"
                bundle="messages.FoldableProjectView"
                id="FoldableProjectViewConfigurable"
                instance="ski.chrzanow.foldableprojectview.settings.FoldableProjectViewConfigurable"
                nonDefaultProject="true"/>

        <searchScopesProvider
                implementation="ski.chrzanow.foldableprojectview.psi.search.FoldableProjectScopesProvider"/>

        <treeStructureProvider
                implementation="ski.chrzanow.foldableprojectview.projectView.FoldableTreeStructureProvider"/>
    </extensions>

    <actions>
        <action id="ProjectView.FoldRootFiles"
                class="ski.chrzanow.foldableprojectview.actionSystem.FoldRootFilesAction">
            <add-to-group
                    group-id="ProjectView.ToolWindow.SecondaryActions"
                    relative-to-action="ProjectView.FoldIgnoredFiles"
                    anchor="before"/>
        </action>
        <action id="ProjectView.FoldIgnoredFiles"
                class="ski.chrzanow.foldableprojectview.actionSystem.FoldIgnoredFilesAction">
            <add-to-group
                    group-id="ProjectView.ToolWindow.SecondaryActions"
                    relative-to-action="ProjectView.FlattenPackages"
                    anchor="before"/>
        </action>
    </actions>
</idea-plugin>
