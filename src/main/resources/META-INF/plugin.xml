<idea-plugin>
    <id>ski.chrzanow.foldableprojectview</id>
    <name>Foldable Project View</name>
    <vendor>hsz</vendor>

    <!-- The description is generated by patchPluginXml from the `Plugin description` section of README.md -->

    <depends>com.intellij.modules.platform</depends>

    <!-- Loaded only when the bundled JSON plugin is available; see ski.chrzanow.foldableprojectview.json.xml -->
    <content>
        <module name="ski.chrzanow.foldableprojectview.json"/>
    </content>

    <resource-bundle>messages.FoldableProjectViewBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <projectConfigurable
                groupId="tools"
                key="foldableProjectView.name"
                bundle="messages.FoldableProjectViewBundle"
                id="FoldableProjectViewConfigurable"
                instance="ski.chrzanow.foldableprojectview.settings.FoldableProjectViewConfigurable"/>

        <webHelpProvider
                implementation="ski.chrzanow.foldableprojectview.settings.FoldableProjectViewHelpProvider"/>

        <searchScopesProvider
                implementation="ski.chrzanow.foldableprojectview.psi.search.FoldableProjectScopesProvider"/>

        <treeStructureProvider
                implementation="ski.chrzanow.foldableprojectview.projectView.FoldableTreeStructureProvider"/>

        <!--suppress PluginXmlCapitalization -->
        <notificationGroup
                id="Foldable Project View"
                displayType="STICKY_BALLOON"
                key="notification.group.foldableProjectView"
                bundle="messages.FoldableProjectViewBundle"/>

        <postStartupActivity
                implementation="ski.chrzanow.foldableprojectview.sponsor.SponsorNotificationActivity"/>
    </extensions>

    <actions>
        <action id="ProjectView.EnableFolding"
                class="ski.chrzanow.foldableprojectview.actionSystem.EnableFoldingAction">
            <add-to-group
                    group-id="ProjectView.ToolWindow.SecondaryActions"
                    relative-to-action="ProjectView.FoldIgnoredFiles"
                    anchor="before"/>
        </action>
        <action id="ProjectView.FoldIgnoredFiles"
                class="ski.chrzanow.foldableprojectview.actionSystem.FoldIgnoredFilesAction">
            <add-to-group
                    group-id="ProjectView.ToolWindow.SecondaryActions"
                    relative-to-action="ProjectView.FlattenPackages"
                    anchor="before"/>
        </action>
        <group id="ProjectView.FoldableProjectView.Sponsor">
            <separator/>
            <action id="ProjectView.FoldableProjectView.SponsorOnGitHub"
                    class="ski.chrzanow.foldableprojectview.actionSystem.SponsorAction"/>
            <add-to-group
                    group-id="ProjectView.ToolWindow.SecondaryActions"
                    anchor="last"/>
        </group>
    </actions>
</idea-plugin>
